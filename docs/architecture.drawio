r" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="142" width="150" height="44" as="geometry"/></mxCell><mxCell id="c7" value="1. Operator request&lt;br&gt;objective and concerns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="200" height="60" as="geometry"/></mxCell><mxCell id="c8" value="2. Planning agent&lt;br&gt;typed scenario change,&lt;br&gt;quoting the request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="185" width="200" height="70" as="geometry"/></mxCell><mxCell id="c9" value="3. Operator&lt;br&gt;confirms change?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="160" height="80" as="geometry"/></mxCell><mxCell id="c10" value="4. Forecast&lt;br&gt;P10 / P50 / P90 load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="190" width="200" height="60" as="geometry"/></mxCell><mxCell id="c11" value="5. Optimization&lt;br&gt;daily MILP per strategy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="190" width="200" height="60" as="geometry"/></mxCell><mxCell id="c12" value="6. Settlement and validation&lt;br&gt;15 min billing, constraint checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="190" width="200" height="60" as="geometry"/></mxCell><mxCell id="c13" value="7. Risk agent&lt;br&gt;selects stress tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;" 